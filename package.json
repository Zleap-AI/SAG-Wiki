{
  "name": "sag-desktop",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test": "vitest run",
    "build:cli": "node scripts/build-cli.mjs",
    "package:windows": "tauri build --config src-tauri/tauri.windows.conf.json",
    "build:cli:dev": "node scripts/build-cli.mjs --debug",
    "package:updates": "node scripts/package-updates.mjs",
    "build:clipper": "npm --prefix browser-extension ci --ignore-scripts && npm --prefix browser-extension run build",
    "build:clipper:safari": "npm --prefix browser-extension ci --ignore-scripts && npm --prefix browser-extension run build -- --safari",
    "build:clipper:desktop": "npm --prefix browser-extension ci --ignore-scripts && node browser-extension/build.mjs --desktop",
    "test:component": "python3 -m unittest discover -s tests -p package_docling_component_test.py",
    "package:macos": "tauri build && npm run test:desktop-package",
    "test:desktop-package": "python3 -m unittest discover -s tests -p desktop_bundle_test.py",
    "pretest": "npm run build:clipper"
  },
  "dependencies": {
    "@lucide/icons": "1.56.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "bits-ui": "2.19.5",
    "dompurify": "^3.2.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "morphdom": "2.7.8",
    "pele": "1.8.0",
    "sigma": "^3.0.3",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/jsdom": "^30.0.0",
    "happy-dom": "^21.0.4",
    "jsdom": "30.1.3",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}

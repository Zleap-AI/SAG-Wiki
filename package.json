{
  "name": "sag-desktop-fnos",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-agent-skills.mjs",
    "prebuild": "node scripts/build-agent-skills.mjs",
    "dev": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build:server": "cargo build -p sag-desktop-fnos --release",
    "package:fnos": "node scripts/package-fnos.mjs",
    "test:fnos": "cargo test -p sag-desktop-fnos",
    "test:e2e": "node tests/fnos-e2e.mjs"
  },
  "dependencies": {
    "@lucide/icons": "1.56.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@trimjs/web-app": "0.5.0",
    "bits-ui": "2.19.5",
    "dompurify": "^3.2.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "morphdom": "2.7.8",
    "sigma": "^3.0.3",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "fflate": "0.8.3",
    "happy-dom": "^21.0.1",
    "playwright": "^1.64.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}

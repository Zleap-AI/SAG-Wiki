{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SAG Wiki",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      },
      {
        "label": "quick-search",
        "title": "SAG Wiki — Quick Search",
        "url": "index.html?quick-search",
        "width": 900,
        "height": 520,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "licenses/LUCIDE.txt": "licenses/LUCIDE.txt",
      "licenses/BITS-UI.txt": "licenses/BITS-UI.txt",
      "licenses/SHADCN-SVELTE.txt": "licenses/SHADCN-SVELTE.txt",
      "licenses/MORPHDOM.txt": "licenses/MORPHDOM.txt",
      "licenses/GRAPH-VIEW.txt": "licenses/GRAPH-VIEW.txt",
      "icons/windows/icon.ico": "icons/sag-rounded-v2.ico",
      "bin/sag.exe": "bin/sag.exe",
      "bin/qpdf/": "bin/qpdf/",
      "licenses/PELE.txt": "licenses/PELE.txt",
      "clipper/sag-web-clipper-chrome.zip": "clipper/sag-web-clipper-chrome.zip"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/windows/icon.ico",
        "uninstallerIcon": "icons/windows/icon.ico"
      }
    },
    "icon": [
      "icons/windows/32x32.png",
      "icons/windows/128x128.png",
      "icons/windows/128x128@2x.png",
      "icons/windows/icon.ico"
    ]
  }
}

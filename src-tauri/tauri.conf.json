{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAG Wiki",
  "version": "0.1.1",
  "identifier": "com.sag.desktop",
  "build": {
    "beforeDevCommand": "npm run build:cli:dev && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:cli && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SAG Wiki",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; worker-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": [
      "licenses/LUCIDE.txt",
      "licenses/BITS-UI.txt",
      "licenses/SHADCN-SVELTE.txt",
      "licenses/MORPHDOM.txt",
      "licenses/GRAPH-VIEW.txt",
      "bin/sag"
    ]
  }
}

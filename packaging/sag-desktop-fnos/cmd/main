#!/bin/bash
set -euo pipefail
umask 077
: "${TRIM_APPDEST:?缺少应用安装目录}"
: "${TRIM_PKGVAR:?缺少应用数据目录}"
: "${TRIM_USERNAME:?缺少应用账户}"
BINARY="$TRIM_APPDEST/bin/sag-desktop-fnos"
WORKER="$TRIM_APPDEST/bin/sag-fnos-worker"
PID_FILE="$TRIM_PKGVAR/app.pid"
WORKER_PID="$TRIM_PKGVAR/worker.pid"
SOCKET="$TRIM_APPDEST/app.sock"
WORKER_SOCKET="$TRIM_APPDEST/worker.sock"

running() {
  local file="$1" binary="$2" pid
  [ -f "$file" ] || return 1
  read -r pid < "$file"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  local executable
  if [ "$binary" = "$BINARY" ]; then
    executable=$(runuser -u "$TRIM_USERNAME" -- readlink -f "/proc/$pid/exe") || return 1
  else
    executable=$(readlink -f "/proc/$pid/exe") || return 1
  fi
  [ "$executable" = "$(readlink -f "$binary")" ]
}

stop_process() {
  local file="$1" binary="$2" pid
  if running "$file" "$binary"; then
    read -r pid < "$file"
    kill -TERM "$pid"
    for ((i=0; i<100; i++)); do
      if ! running "$file" "$binary"; then break; fi
      sleep 0.1
    done
    if running "$file" "$binary"; then kill -KILL "$pid"; fi
  fi
  rm -f "$file"
}

case "${1:-}" in
  start)
    if running "$PID_FILE" "$BINARY" && running "$WORKER_PID" "$WORKER" && [ -S "$SOCKET" ] && [ -S "$WORKER_SOCKET" ]; then exit 0; fi
    : "${TRIM_API_TOKEN:?飞牛未提供原生 API 令牌}"
    app_uid=$(id -u "$TRIM_USERNAME")
    app_gid=$(id -g "$TRIM_USERNAME")
    [ "$app_uid" -ne 0 ]
    stop_process "$PID_FILE" "$BINARY"
    stop_process "$WORKER_PID" "$WORKER"
    mkdir -p "$TRIM_PKGVAR/users" "$TRIM_PKGVAR/mcp-workers"
    chown "$app_uid:$app_gid" "$TRIM_APPDEST" "$TRIM_PKGVAR" "$TRIM_PKGVAR/users"
    chmod u+rwx "$TRIM_APPDEST"
    chmod 711 "$TRIM_PKGVAR"
    chmod 700 "$TRIM_PKGVAR/users"
    chown root:root "$TRIM_PKGVAR/mcp-workers"
    chmod 711 "$TRIM_PKGVAR/mcp-workers"
    rm -f "$SOCKET" "$WORKER_SOCKET"
    env -i PATH=/usr/bin:/bin "$WORKER" "$WORKER_SOCKET" "$app_uid" "$TRIM_PKGVAR/mcp-workers" >> "$TRIM_PKGVAR/worker.log" 2>&1 &
    echo "$!" > "$WORKER_PID"
    # Write the actual service PID, rather than the runuser supervisor's PID.
    runuser -u "$TRIM_USERNAME" -- /bin/sh -c 'echo "$$" > "$1"; exec "$2"' sh "$PID_FILE" "$BINARY" >> "$TRIM_PKGVAR/app.log" 2>&1 &
    for ((i=0; i<100; i++)); do
      if running "$PID_FILE" "$BINARY" && running "$WORKER_PID" "$WORKER" && [ -S "$SOCKET" ] && [ -S "$WORKER_SOCKET" ]; then exit 0; fi
      sleep 0.1
    done
    stop_process "$PID_FILE" "$BINARY"
    stop_process "$WORKER_PID" "$WORKER"
    rm -f "$SOCKET" "$WORKER_SOCKET"
    printf '%s\n' 'SAG Wiki 启动失败，请检查应用日志。' > "${TRIM_TEMP_LOGFILE:-$TRIM_PKGVAR/start-error.log}"
    exit 1
    ;;
  stop)
    stop_process "$PID_FILE" "$BINARY"
    stop_process "$WORKER_PID" "$WORKER"
    rm -f "$SOCKET" "$WORKER_SOCKET"
    ;;
  status)
    if running "$PID_FILE" "$BINARY" && running "$WORKER_PID" "$WORKER" && [ -S "$SOCKET" ] && [ -S "$WORKER_SOCKET" ]; then exit 0; fi
    exit 3
    ;;
  *) exit 1 ;;
esac
